# 上线前检查：grep -rn "【上线前" . --exclude-dir=node_modules --exclude-dir=dist --exclude-dir=docs

# === 前端（VITE_ 前缀的才会暴露到浏览器） ===
VITE_BASE_URL=/
# 【上线前必改】后端接口地址。VITE_ 是构建时打进产物的，改完必须重新 npm run build。
#  - 开发：http://127.0.0.1:3000（前端直连本地后端）
#  - 生产：留空（VITE_API_BASE_URL=），让前端用「同源相对路径」请求 /api/...，由 Nginx
#    反代到 127.0.0.1:3000。页面与接口同域，不触发 CORS。
#  ⚠️ 生产不要填绝对域名：填 https://jiemids.com 会在 www/裸域 之间跨域被浏览器拦；
#    更不要带 /api 后缀（如 https://jiemids.com/api）—— 请求路径本身已以 /api 开头，会拼成 /api/api。
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_MOCK_ADMIN_USERNAME=admin
VITE_MOCK_ADMIN_PASSWORD=  # mock 管理员默认密码，请修改

# === 后端（Node.js process.env 读取，无前缀） ===
# JWT 签名密钥：必须是随机长串，且**不要**加 VITE_ 前缀（那样会打包进前端 bundle 公开下发）。
# 缺失时服务会拒绝启动（见 server/util/jwt.js），这是刻意的
JWT_SECRET=
PORT=3000

# 单店模式店铺名（可选，不配默认「杰米小店」）
# VITE_SHOP_NAME=杰米小店
